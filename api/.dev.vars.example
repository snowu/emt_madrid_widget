EMT_EMAIL=developer@example.com
EMT_PASSWORD=replace-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
OWNER_USER_ID=replace-with-owner-auth-uuid
# Optional overrides when MPass uses different credentials:
# MPASS_EMAIL=owner@example.com
# MPASS_PASSWORD=replace-me
MPASS_CLIENT_ID=replace-me
MPASS_PASSKEY=replace-me
MPASS_DEVICE_ID=replace-me
# Optional: per-user EMT accounts. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, everyone uses the shared EMT login above.
# EMT_CREDENTIAL_KEY=replace-me
